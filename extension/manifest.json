{
  "manifest_version": 3,
  "name": "PriceTrail — Price History & Compare",
  "short_name": "PriceTrail",
  "version": "1.2.0",
  "description": "Price history and store comparison for Amazon.in, Flipkart, Croma, Reliance Digital and more, with price-drop alerts.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PriceTrail",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "https://www.croma.com/*",
    "https://www.reliancedigital.in/*",
    "https://www.tatacliq.com/*",
    "https://www.myntra.com/*",
    "https://www.ajio.com/*",
    "https://api.croma.com/*",
    "https://web.archive.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://www.flipkart.com/*",
        "https://www.croma.com/*",
        "https://www.reliancedigital.in/*",
        "https://www.tatacliq.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*"
      ],
      "js": [
        "lib/sites.js",
        "lib/extract.js",
        "lib/util.js",
        "content/widget.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
